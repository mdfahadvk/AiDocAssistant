GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
MAX_HISTORY_TURNS=6
# Browser cookie authentication. Keep enabled in production; set false locally.
AUTH_REQUIRED=true
# DOCS_DIR=docs
# CHROMA_DIR=chroma_store
# CHROMA_MODE=local
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# Maximum Chroma cosine distance accepted as relevant (lower is stricter; default 0.65)
# RETRIEVAL_MAX_DISTANCE=0.65
# PROJECT_MAPPING_FILE=project_mapping.json
# NLP_PROVIDER=local
# SPACY_MODEL=en_core_web_sm
# NLP_TERMS_FILE=config/nlp_terms.json
# NLP_MAX_RETRIEVAL_QUERIES=5
# RAG_MAX_CONTEXT_CHARS=24000
# Answer confidence weights (must total 1.0)
# CONFIDENCE_RETRIEVAL_WEIGHT=0.30
# CONFIDENCE_GROUNDEDNESS_WEIGHT=0.30
# CONFIDENCE_CITATION_WEIGHT=0.20
# CONFIDENCE_CONSISTENCY_WEIGHT=0.10
# CONFIDENCE_SCOPE_WEIGHT=0.10
# For Chroma Cloud, use CHROMA_MODE=cloud and set these values:
# CHROMA_API_KEY=your_chroma_cloud_api_key
# CHROMA_TENANT=your_tenant_id
# CHROMA_DATABASE=your_database_name
